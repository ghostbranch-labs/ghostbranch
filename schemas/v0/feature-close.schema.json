{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature close data",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "state", "deleted", "gate_pr", "approval", "preview"],
  "properties": {
    "feature": { "type": "string" },
    "state": {
      "description": "the state the feature was closed from",
      "enum": ["draft", "in_review", "gate_passed", "published", "merged", "merged_moved", "pr_closed", "branch_gone", "abandoned"]
    },
    "deleted": {
      "description": "each shadow-repo ref deleted, with the SHA it pointed at; empty under --plan",
      "type": "object",
      "propertyNames": { "pattern": "^refs/" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/sha" }
    },
    "gate_pr": { "description": "the gate's draft PR that was closed; null when none was open", "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
    "approval": {
      "description": "how the close was approved; null when it needed no console (published, merged and unmoved)",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "console" } } }
      ]
    },
    "preview": { "oneOf": [{ "type": "null" }, { "$ref": "preview.schema.json" }] }
  }
}
