{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Promote plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "actor", "created_at", "pair", "feature", "mode", "fingerprint",
               "curate", "publish", "typed", "leak", "ci"],
  "properties": {
    "prs": { "description": "the chain's PRs, bottom first", "type": "array", "items": { "$ref": "common.schema.json#/$defs/stackPR" } },
    "stack_number": { "$ref": "common.schema.json#/$defs/stackNumber" },
    "schema_version": { "const": "0.12" },
    "id": { "$ref": "common.schema.json#/$defs/planId" },
    "kind": { "const": "promote" },
    "actor": { "$ref": "common.schema.json#/$defs/actor" },
    "created_at": { "$ref": "common.schema.json#/$defs/time" },
    "pair": {
      "type": "object", "additionalProperties": false, "required": ["public", "shadow"],
      "properties": { "public": { "$ref": "common.schema.json#/$defs/repo" }, "shadow": { "$ref": "common.schema.json#/$defs/repo" } }
    },
    "feature": { "type": "string" },
    "mode": { "enum": ["squash", "preserve", "curated"] },
    "curate": { "oneOf": [ { "type": "null" }, { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["from", "message"],
      "properties": { "from": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sha" } },
        "message": { "type": "string", "minLength": 1 } } } } ] },
    "fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["public_main", "feature_head", "overlay", "gate_candidate"],
      "properties": {
        "public_main": { "$ref": "common.schema.json#/$defs/sha" },
        "feature_head": { "$ref": "common.schema.json#/$defs/sha" },
        "overlay": { "$ref": "common.schema.json#/$defs/sha" },
        "gate_candidate": { "$ref": "common.schema.json#/$defs/sha" }
      }
    },
    "publish": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "parent", "target_branch", "pr", "commits", "dropped_empty"],
      "dependentRequired": { "style": ["update"], "expected_head": ["update"], "replace_reason": ["style"], "restores": ["style"] },
      "allOf": [
        { "if": { "properties": { "update": { "const": true } }, "required": ["update"] },
          "then": { "required": ["style", "expected_head"] },
          "else": { "properties": { "pr": { "properties": { "title": { "minLength": 1 } } } } } },
        { "if": { "properties": { "style": { "const": "replace" } }, "required": ["style"] },
          "then": { "required": ["replace_reason"], "properties": { "replace_reason": { "minLength": 1 } } },
          "else": { "properties": { "replace_reason": { "const": "" }, "restores": { "maxItems": 0 } } } }
      ],
      "properties": {
        "commit": { "$ref": "common.schema.json#/$defs/sha" },
        "tree": { "$ref": "common.schema.json#/$defs/sha" },
        "parent": { "$ref": "common.schema.json#/$defs/sha" },
        "commits": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
          "required": ["commit", "tree", "parent", "sources", "author", "subject"],
          "properties": {
            "commit": { "$ref": "common.schema.json#/$defs/sha" },
            "tree": { "$ref": "common.schema.json#/$defs/sha" },
            "parent": { "$ref": "common.schema.json#/$defs/sha" },
            "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sha" } },
            "author": { "type": "object", "additionalProperties": false, "required": ["name", "email", "date"],
              "properties": { "name": { "type": "string" }, "email": { "type": "string" },
                "date": { "$ref": "common.schema.json#/$defs/time" } } },
            "subject": { "type": "string" }
          } } },
        "dropped_empty": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sha" } },
        "target_branch": { "type": "string" },
        "pr": {
          "type": "object", "additionalProperties": false, "required": ["title", "body"],
          "properties": { "title": { "description": "never empty in a first publish; an update may leave it empty, because it doesn't retitle the open PR", "type": "string" }, "body": { "type": "string" } }
        },
        "update": { "description": "true when the plan updates the feature's open PR; absent in a first publish", "type": "boolean" },
        "style": { "description": "how the PR's branch is updated: append (a fast-forward with the new commits) or replace (a force-push leased on expected_head)", "enum": ["append", "replace"] },
        "replace_reason": { "description": "why the branch is replaced rather than appended to; absent or empty for append", "enum": ["restack", "rebase", "squash", "curated", "base_changed", "conflict", "reworded", ""] },
        "expected_head": { "description": "the PR branch's head when the plan was made; apply pushes only while it is still there", "$ref": "common.schema.json#/$defs/sha" },
        "restores": { "description": "commits on the PR's branch that a replace puts back; only with style replace", "type": "array", "items": { "$ref": "common.schema.json#/$defs/sha" } }
      }
    },
    "typed": {
      "description": "which PR texts the person typed (--title, --body); a re-plan passes on only these and derives the others again",
      "type": "object", "additionalProperties": false, "required": ["title", "body"],
      "properties": { "title": { "type": "boolean" }, "body": { "type": "boolean" } }
    },
    "leak": {
      "type": "object", "additionalProperties": false, "required": ["findings", "waived", "warnings", "scanner_version"],
      "properties": {
        "findings": { "type": "array", "maxItems": 0 },
        "waived": { "type": "array", "items": { "type": "object", "additionalProperties": false,
          "required": ["id", "rule", "where", "path", "reason"],
          "properties": { "id": { "type": "string", "pattern": "^f-[0-9a-f]{12}$" }, "rule": { "type": "string" },
            "where": { "enum": ["tree", "path"] }, "path": { "type": "string" }, "reason": { "type": "string" } } } },
        "warnings": { "type": "array", "items": { "type": "object", "required": ["code", "message"] } },
        "scanner_version": { "type": "string" }
      }
    },
    "ci": {
      "type": "object", "additionalProperties": false, "required": ["repo_guards"],
      "properties": { "repo_guards": { "$ref": "common.schema.json#/$defs/guardReport" } }
    },
    "chain": {
      "description": "a stack plan's branches, bottom first; feature, mode, fingerprint, publish, typed and ci above are the first entry's",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["feature", "mode", "fingerprint", "publish", "typed", "ci"],
        "properties": {
          "feature": { "type": "string" },
          "mode": { "enum": ["squash", "preserve", "curated"] },
          "fingerprint": { "$ref": "#/properties/fingerprint" },
          "publish": { "$ref": "#/properties/publish" },
          "typed": { "$ref": "#/properties/typed" },
          "ci": { "$ref": "#/properties/ci" }
        }
      }
    }
  }
}
