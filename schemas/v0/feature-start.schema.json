{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature start data",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "branch", "base", "parent", "checkout", "checkout_hint", "preview"],
  "properties": {
    "name": { "type": "string" },
    "branch": { "type": "string" },
    "base": { "$ref": "common.schema.json#/$defs/sha" },
    "parent": { "description": "the feature this one is stacked on (--from), or main", "type": "string", "minLength": 1 },
    "checkout": {
      "description": "the commands that get the branch into a checkout, run in order; each is an argv",
      "type": "array", "minItems": 1,
      "items": { "type": "array", "minItems": 2, "items": { "type": "string" } }
    },
    "checkout_hint": { "description": "checkout as one shell line, the argvs joined with ' && '", "type": "string" },
    "preview": { "oneOf": [{ "type": "null" }, { "$ref": "preview.schema.json" }] }
  }
}
