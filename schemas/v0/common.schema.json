{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghostbranch shared definitions",
  "$defs": {
    "stackPR": {
      "description": "one PR of a published chain, bottom first: the feature, the public branch it targets (the base branch by its real name, or the branch below), and the PR; number is 0 and url empty in a plan, before apply opens it; update and style are set for an open PR the plan updates",
      "type": "object", "additionalProperties": false,
      "required": ["feature", "base", "number", "url"],
      "dependentRequired": { "style": ["update"] },
      "if": { "properties": { "update": { "const": true } }, "required": ["update"] },
      "then": { "required": ["style"] },
      "properties": {
        "feature": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 0 },
        "url": { "type": "string" },
        "update": { "type": "boolean" },
        "style": { "enum": ["append", "replace"] }
      }
    },
    "stackNumber": {
      "description": "the native GitHub stack the PRs are in; null for a single PR, or for plain chained PRs where native stacks aren't available",
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    },
    "commitInfo": {
      "description": "one feature commit: its source SHA, subject, author and the files it changes",
      "type": "object", "additionalProperties": false,
      "required": ["source", "subject", "author", "files"],
      "properties": {
        "source": { "$ref": "#/$defs/sha" },
        "subject": { "type": "string" },
        "author": { "description": "\"Name <email>\" as committed", "type": "string" },
        "files": {
          "description": "the paths the commit changes from its parent, overlay paths left out; may include changes that are internal only",
          "type": "array", "items": { "type": "string" }
        }
      }
    },
    "checkId": { "description": "a doctor check, in the order doctor runs them", "enum": ["tools", "token", "app", "pair", "guard", "state", "ci"] },
    "tokenKind": { "description": "from the token's prefix: ghu_ app, github_pat_ fine-grained, ghp_ classic, gho_ oauth", "enum": ["app", "fine-grained", "classic", "oauth", "unknown"] },
    "doctorSummary": {
      "description": "doctor's counts by status and the failed check IDs; init's data.doctor",
      "type": "object", "additionalProperties": false,
      "required": ["ok", "warn", "fail", "skipped", "failed"],
      "properties": {
        "ok": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "failed": { "type": "array", "items": { "$ref": "#/$defs/checkId" } }
      }
    },
    "archived": {
      "description": "a feature handed off to the public repo (6.5): its shadow branch was moved to ref, at head, at at",
      "type": "object", "additionalProperties": false, "required": ["at", "ref", "head"],
      "properties": {
        "at": { "$ref": "#/$defs/time" },
        "ref": { "type": "string", "pattern": "^refs/ghostbranch/archive/" },
        "head": { "$ref": "#/$defs/sha" }
      }
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "shaOrEmpty": { "type": "string", "pattern": "^([0-9a-f]{40}([0-9a-f]{24})?)?$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "time": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "pattern": "^(human:\\S+|app|agent:\\S+)$" },
    "planId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" },
    "guard": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "job", "step", "expr", "rewritable"],
      "properties": {
        "path": { "type": "string" }, "job": { "type": "string" },
        "step": { "type": ["string", "null"] }, "expr": { "type": "string" },
        "rewritable": { "type": "boolean" }
      }
    },
    "guardReport": {
      "type": "object", "additionalProperties": false, "required": ["mode", "rewritten", "unrewritable"],
      "properties": {
        "mode": { "enum": ["rewrite", "warn", "off"] },
        "rewritten": { "type": "array", "items": { "$ref": "#/$defs/guard" } },
        "unrewritable": { "type": "array", "items": { "$ref": "#/$defs/guard" } },
        "skipped": { "description": "Rewritable guards left as they are because ci.rewrite_repo_guards is warn, so their jobs skip in the shadow repo too; absent in a plan written before 0.9.",
          "type": "array", "items": { "$ref": "#/$defs/guard" } }
      }
    }
  }
}
