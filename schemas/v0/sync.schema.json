{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sync data",
  "type": "object",
  "additionalProperties": false,
  "required": ["public", "shadow", "action", "public_main", "shadow_main_before", "shadow_main_after", "branches", "cancelled_runs", "closed", "active_features", "attention", "preview"],
  "properties": {
    "public": { "$ref": "common.schema.json#/$defs/repo" },
    "shadow": { "$ref": "common.schema.json#/$defs/repo" },
    "action": { "enum": ["noop", "fast_forward", "diverged"] },
    "public_main": { "$ref": "common.schema.json#/$defs/sha" },
    "shadow_main_before": { "$ref": "common.schema.json#/$defs/shaOrEmpty" },
    "shadow_main_after": { "$ref": "common.schema.json#/$defs/shaOrEmpty" },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "from", "to", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "from": { "$ref": "common.schema.json#/$defs/shaOrEmpty" },
          "to": { "$ref": "common.schema.json#/$defs/shaOrEmpty" },
          "status": { "enum": ["up_to_date", "created", "fast_forwarded", "diverged"] }
        }
      }
    },
    "cancelled_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workflow", "url"],
        "properties": {
          "id": { "type": "integer" },
          "workflow": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "closed": {
      "description": "merged features sync closed (never in a dry run: the preview has their ops)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "public_pr", "deleted"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "public_pr": { "type": "integer" },
          "deleted": {
            "description": "each shadow ref deleted, with the SHA it pointed at",
            "type": "object",
            "additionalProperties": { "$ref": "common.schema.json#/$defs/sha" }
          }
        }
      }
    },
    "active_features": { "description": "features neither abandoned nor merged", "type": "integer", "minimum": 0 },
    "attention": {
      "description": "merged_moved, pr_closed and branch_gone features sync won't close: a person must look at them",
      "type": "array",
      "items": { "$ref": "feature-report.schema.json" }
    },
    "preview": { "oneOf": [{ "type": "null" }, { "$ref": "preview.schema.json" }] }
  }
}
