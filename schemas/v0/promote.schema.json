{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "promote data",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "plan", "plan_path", "findings", "waived", "applied", "preview"],
  "properties": {
    "prs": { "description": "the chain's PRs, bottom first", "type": "array", "items": { "$ref": "common.schema.json#/$defs/stackPR" } },
    "stack_number": { "$ref": "common.schema.json#/$defs/stackNumber" },
    "gate": { "oneOf": [{ "type": "null" }, { "$ref": "gate.schema.json" }] },
    "plan": { "oneOf": [{ "type": "null" }, { "$ref": "plan.schema.json" }] },
    "plan_path": { "type": "string" },
    "findings": { "type": "array", "items": { "$ref": "finding.schema.json" } },
    "waived": { "type": "array", "items": { "$ref": "waived.schema.json" } },
    "applied": { "oneOf": [{ "type": "null" }, { "$ref": "apply.schema.json" }] },
    "preview": { "oneOf": [{ "type": "null" }, { "$ref": "preview.schema.json" }] }
  }
}
