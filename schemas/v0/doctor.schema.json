{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doctor data",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks"],
  "properties": {
    "checks": {
      "description": "every check, in order: tools, token, app, pair, guard, state, ci (fewer only when doctor was interrupted)",
      "type": "array", "maxItems": 7,
      "items": { "$ref": "#/$defs/check" }
    },
    "update_check": {
      "description": "the update checker (6.4a): whether it is on and what a fresh look found. The CLI always sets it; the engine's own result lacks it",
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "off_reason", "checked_at", "current", "latest", "security", "advisories", "upgrade", "error", "override"],
      "properties": {
        "enabled": { "type": "boolean" },
        "off_reason": { "enum": ["", "GHOSTBRANCH_NO_UPDATE_CHECK", "CI", "development build", "no state directory"] },
        "checked_at": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/time" }] },
        "current": { "description": "this binary's version, without the v", "type": "string" },
        "latest": { "description": "the newest release seen, without the v; empty when none", "type": "string" },
        "security": { "type": "boolean" },
        "advisories": { "type": "array", "items": { "type": "string" } },
        "upgrade": { "description": "the command that upgrades this install, or the release page", "type": "string" },
        "error": { "description": "why the last look failed; empty when it didn't", "type": "string" },
        "override": { "description": "GHOSTBRANCH_UPDATE_URL (test-only), empty when unset", "type": "string" }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "message", "fix", "details"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/checkId" },
        "status": { "enum": ["ok", "warn", "fail", "skipped"] },
        "message": { "type": "string", "minLength": 1 },
        "fix": { "description": "a command that fixes it, or for the app check, the link to open; for reading; empty when there is none. error.next carries the failing checks' fix commands as argv; a failing app check's link adds nothing to it", "type": "string" },
        "details": {
          "description": "the check's findings; open, so a later version may add fields. tools: git, git_minimum, version, commit. token: source, kind, account, can_publish, expires, refresh_expires, agent_on_person_login, groups. app: installed, selection, accounts. pair: public, shadow, public_private, shadow_private, behind, overlay_status. guard: checkout, hooks_dir, installed, workspace, remotes, publics. state: workspace, dir, features. ci: guards, secrets_listed, missing_secrets, push_triggers.",
          "type": "object",
          "properties": {
            "git": { "type": "string" },
            "git_minimum": { "type": "string" },
            "version": { "type": "string" },
            "commit": { "type": "string" },
            "source": { "enum": ["", "GHOSTBRANCH_TOKEN", "login", "GH_TOKEN", "GITHUB_TOKEN", "gh auth token"] },
            "kind": { "description": "empty with no token", "oneOf": [{ "const": "" }, { "$ref": "common.schema.json#/$defs/tokenKind" }] },
            "account": { "type": "string" },
            "can_publish": { "enum": ["true", "false", "unknown"] },
            "expires": { "$ref": "common.schema.json#/$defs/time" },
            "refresh_expires": { "$ref": "common.schema.json#/$defs/time" },
            "agent_on_person_login": { "type": "boolean" },
            "installed": { "type": "boolean" },
            "selection": { "enum": ["", "all", "selected"] },
            "accounts": { "type": "array", "items": { "type": "object" } },
            "groups": {
              "description": "what the token lacks per command group, each entry \"<permission> on <owner/repo>\"",
              "type": "object", "additionalProperties": false,
              "required": ["init", "sync", "gate", "promote", "audit"],
              "properties": {
                "init": { "$ref": "#/$defs/groupAccess" },
                "sync": { "$ref": "#/$defs/groupAccess" },
                "gate": { "$ref": "#/$defs/groupAccess" },
                "promote": { "$ref": "#/$defs/groupAccess" },
                "audit": { "$ref": "#/$defs/groupAccess" }
              }
            },
            "public": { "$ref": "common.schema.json#/$defs/repo" },
            "shadow": { "$ref": "common.schema.json#/$defs/repo" },
            "public_private": { "type": "boolean" },
            "shadow_private": { "type": "boolean" },
            "behind": { "type": "integer", "minimum": 1 },
            "overlay_status": { "type": "string" },
            "checkout": { "type": "string" },
            "hooks_dir": { "type": "string" },
            "installed": { "type": "boolean" },
            "workspace": { "type": "string" },
            "remotes": { "type": ["array", "null"], "items": { "type": "string" } },
            "publics": { "type": ["array", "null"], "items": { "type": "string" } },
            "dir": { "type": "string" },
            "features": { "type": "integer", "minimum": 0 },
            "guards": { "type": "integer", "minimum": 0 },
            "secrets_listed": { "type": "boolean" },
            "missing_secrets": { "type": ["array", "null"], "items": { "type": "string" } },
            "push_triggers": { "type": ["array", "null"], "items": { "type": "string" } }
          }
        }
      }
    },
    "groupAccess": {
      "type": "object", "additionalProperties": false,
      "required": ["missing", "unknown", "optional_missing"],
      "properties": {
        "missing": { "type": "array", "items": { "type": "string" } },
        "unknown": { "type": "array", "items": { "type": "string" } },
        "optional_missing": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
