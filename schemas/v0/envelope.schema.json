{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghostbranch command output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok", "exit_code", "data", "warnings", "next", "error"],
  "properties": {
    "schema_version": { "const": "0.11" },
    "command": { "enum": ["ghostbranch", "init", "sync", "audit", "upgrade", "feature start", "gate", "promote", "apply", "agents allow", "agents revoke", "agents status", "explain", "guide", "guard install", "guard uninstall", "guard status", "guard check", "waivers add", "waivers list", "waivers revoke", "status", "feature list", "feature show", "feature abandon", "feature close", "remove", "log", "wait", "login", "logout", "auth status", "doctor", "feature fold", "feature restack"] },
    "ok": { "type": "boolean" },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 6 },
    "data": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "enum": ["CONFIG_KEY_IGNORED", "PUBLIC_NOT_PUBLIC", "GATE_NOT_RECORDED", "CHECKS_LIMITED", "ACTOR_UNKNOWN",
                          "WORKFLOW_CHANGED", "LARGE_FILE", "BINARY_FILE", "WAIVERS_UNREADABLE",
                          "OVERLAY_OUTDATED", "REPO_GUARD", "REPO_GUARD_UNREWRITABLE", "SECRETS_UNLISTED", "SECRETS_MISSING",
                          "PUSH_TRIGGERS_ON_SYNC", "ACTIONS_MINUTES_BILLED", "SHADOW_BEHIND", "AUDIT_INCOMPLETE",
                          "CI_NOT_CANCELLED", "PR_STATE_UNKNOWN", "DRIFT_UNKNOWN", "FEATURE_NOT_CLOSED", "MIRROR_NOT_UPDATED",
                          "RECORD_NEWER", "RECORD_UNREADABLE", "LEDGER_NOT_WRITTEN",
                          "SYNC_PUSH_FAILED", "PLAN_FILE_UNREADABLE", "AGENT_ON_PERSON_LOGIN", "PUBLIC_BRANCH_CHANGED"] },
          "message": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "why", "needs_human", "needs_input"],
        "properties": {
          "command": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "why": { "type": "string" },
          "needs_human": { "type": "boolean" },
          "needs_input": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "field", "retryable", "details"],
          "properties": {
            "code": {
              "enum": ["AUTH_MISSING", "FORGE_ERROR", "SHADOW_NOT_PRIVATE", "CONFIG_INVALID", "LOCKED", "INTERNAL",
                       "BAD_FLAG", "MISSING_INPUT", "PAIR_AMBIGUOUS", "NAME_INVALID", "FEATURE_NOT_FOUND",
                       "CHECKS_FAILED", "NO_CI", "CI_TIMEOUT", "LEAK_FOUND",
                       "REBASE_CONFLICT", "SYNC_DIVERGED", "BRANCH_EXISTS", "OVERLAY_COLLISION", "SHADOW_NOT_EMPTY", "REF_MOVED", "SHADOW_CREATE_DENIED",
                       "CURATE_INVALID", "CURATE_CONFLICT", "CURATE_TREE_MISMATCH", "AUTHOR_UNMAPPED", "NOTHING_TO_PUBLISH",
                       "APPROVAL_REQUIRED", "PLAN_STALE",
                       "TOKEN_CANNOT_PUBLISH", "GUARD_UNSUPPORTED", "PUSH_BLOCKED", "PUSH_REFUSED", "NOT_A_PAIR_CHECKOUT",
                       "MARKER_INVALID", "WAIVER_UNKNOWN", "UPGRADE_NEEDED", "FEATURE_MOVED", "SHADOW_BEHIND", "INTERRUPTED", "JOB_NOT_FOUND", "JOB_STALE",
                       "LOGIN_EXPIRED", "LOGIN_UNAVAILABLE", "TOKEN_PERMISSION_MISSING", "DOCTOR_FAILED",
                       "FOLD_NEEDS_REBASE", "HAS_CHILDREN", "NOT_A_STACK", "PARENT_REWRITTEN"]
            },
            "message": { "type": "string" },
            "field": { "type": ["string", "null"] },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          }
        }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "ok": { "const": true } } },
      "then": { "properties": { "exit_code": { "const": 0 }, "error": { "type": "null" } } } },
    { "if": { "properties": { "ok": { "const": false } } },
      "then": { "properties": { "exit_code": { "minimum": 1 }, "error": { "type": "object" } } } }
  ]
}
