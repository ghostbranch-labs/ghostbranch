{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature.json (refs/ghostbranch/features/<name>)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "branch", "created_by", "created_at", "base", "abandoned", "gate", "promoted"],
  "properties": {
    "schema_version": { "const": "0.6" },
    "name": { "type": "string" },
    "branch": { "type": "string" },
    "created_by": { "$ref": "common.schema.json#/$defs/actor" },
    "created_at": { "$ref": "common.schema.json#/$defs/time" },
    "base": { "$ref": "common.schema.json#/$defs/sha" },
    "abandoned": { "type": "boolean" },
    "gate": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["feature_head", "public_main", "overlay", "candidate", "published_tree", "checks", "leak", "at"],
          "properties": {
            "feature_head": { "$ref": "common.schema.json#/$defs/sha" },
            "public_main": { "$ref": "common.schema.json#/$defs/sha" },
            "overlay": { "$ref": "common.schema.json#/$defs/sha" },
            "candidate": { "$ref": "common.schema.json#/$defs/sha" },
            "published_tree": { "$ref": "common.schema.json#/$defs/sha" },
            "scanned_as": {
              "description": "The mode the gate's leak scan covered; absent in a gate recorded by an older binary.",
              "enum": ["squash", "preserve", "curated"]
            },
            "checks": { "enum": ["passed", "failed", "no_ci", "timeout", "not_run"] },
            "leak": { "enum": ["clean", "found", "not_run"] },
            "commits": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["source", "rebased"],
                "properties": {
                  "source": { "$ref": "common.schema.json#/$defs/sha" },
                  "rebased": { "$ref": "common.schema.json#/$defs/sha" }
                }
              }
            },
            "at": { "$ref": "common.schema.json#/$defs/time" }
          }
        }
      ]
    },
    "promoted": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["public_pr", "plan_id"],
          "properties": {
            "public_pr": { "type": "integer", "minimum": 1 },
            "plan_id": { "$ref": "common.schema.json#/$defs/planId" },
            "feature_head": { "description": "The head the publish was planned from; absent in a record written before 0.6.", "$ref": "common.schema.json#/$defs/sha" }
          }
        }
      ]
    }
  }
}
