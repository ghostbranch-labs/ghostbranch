{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One ledger.jsonl line",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "actor", "op", "exit_code", "summary"],
  "properties": {
    "ts": { "$ref": "common.schema.json#/$defs/time" },
    "actor": { "$ref": "common.schema.json#/$defs/actor" },
    "op": { "enum": ["init", "sync", "upgrade", "feature start", "gate", "promote", "apply", "agents allow", "agents revoke", "waivers add", "waivers revoke", "remove", "feature abandon", "feature close", "feature fold", "feature restack", "feature pull", "feature archive", "grant_created", "grant_replaced", "grant_revoked", "wait"] },
    "pair": { "$ref": "common.schema.json#/$defs/repo" },
    "feature": { "type": "string" },
    "plan_id": { "$ref": "common.schema.json#/$defs/planId" },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 6 },
    "error_code": { "type": "string" },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["console", "grant"] },
        "grant_id": { "type": "string", "pattern": "^g-[0-9a-f]{6}$" },
        "created_by": { "$ref": "common.schema.json#/$defs/actor" }
      }
    },
    "waivers": { "type": "array", "items": { "type": "string", "pattern": "^f-[0-9a-f]{12}$" } },
    "reason": { "type": "string" },
    "refs": {
      "description": "the shadow-repo refs the entry deleted, each with the SHA it pointed at",
      "type": "object",
      "propertyNames": { "pattern": "^refs/" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/sha" }
    },
    "grant": {
      "type": "object", "additionalProperties": false, "required": ["id", "expires_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^g-[0-9a-f]{6}$" },
        "expires_at": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/time" }] }
      }
    },
    "summary": { "type": "string" }
  }
}
