class Ghostbranch < Formula
  desc "Private branches for public GitHub repos"
  homepage "https://ghostbranch.site"
  version "{{ .Version }}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "{{ .DarwinARM64.URL }}"
      sha256 "{{ .DarwinARM64.SHA256 }}"
    end
    on_intel do
      url "{{ .DarwinAMD64.URL }}"
      sha256 "{{ .DarwinAMD64.SHA256 }}"
    end
  end

  on_linux do
    on_arm do
      url "{{ .LinuxARM64.URL }}"
      sha256 "{{ .LinuxARM64.SHA256 }}"
    end
    on_intel do
      url "{{ .LinuxAMD64.URL }}"
      sha256 "{{ .LinuxAMD64.SHA256 }}"
    end
  end

  def install
    bin.install "ghostbranch"
  end

  test do
    assert_match version.to_s, shell_output("GHOSTBRANCH_NO_UPDATE_CHECK=1 #{bin}/ghostbranch version")
  end
end
