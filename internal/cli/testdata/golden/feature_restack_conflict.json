          "fetch",
          "shadow"
        ],
        [
          "git",
          "switch",
          "feat-y"
        ],
        [
          "git",
          "rebase",
          "--onto",
          "shadow/feat-x",
          "<SHA1>",
          "feat-y"
        ],
        [
          "git",
          "push",
          "--force-with-lease",
          "shadow",
