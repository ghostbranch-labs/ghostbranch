      "why": "push the rebased branch, leased so it never overwrites someone else's push",
      "needs_human": false,
      "needs_input": []
    },
    {
      "command": [
        "ghostbranch",
        "feature",
        "restack",
        "feat-x",
        "--repo",
        "acme/widget"
