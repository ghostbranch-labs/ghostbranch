        "fetch",
        "shadow"
      ],
      "why": "fetch the shadow repo in your checkout (shadow is its remote there)",
      "needs_human": false,
      "needs_input": []
    },
    {
      "command": [
        "git",
        "switch",
        "feat-y"
      ],
      "why": "switch to feat-y",
      "needs_human": false,
      "needs_input": []
